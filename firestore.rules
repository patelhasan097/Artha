// ═══════════════════════════════════════════════════════════════
//  Firestore Security Rules — paste into Firebase Console →
//  Firestore Database → Rules tab → Publish.
//
//  This is the real security boundary (not the config.js values).
//  It ensures every user can only read/write their OWN data.
// ═══════════════════════════════════════════════════════════════

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /portfolio/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /mutualfunds/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /watchlist/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
